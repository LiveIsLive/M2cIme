// UTF-8 代码页必须在任何 include 之前声明，
// 否则 resource.h 等头文件里的中文注释会按系统 ANSI 代码页解析，
// 可能吞掉紧随其后的 #define（曾导致 IDD_SETTINGS 宏未定义，对话框被编译成字符串名资源）。
#pragma code_page(65001)

#include "resource.h"
#include <windows.h>

IDI_M2C ICON "M2CIME.ico"

IDD_SETTINGS DIALOGEX 0, 0, 210, 116
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT           "输入方式：",IDC_STATIC,16,20,48,12
    COMBOBOX        IDC_INPUT_MODE_COMBO,70,17,124,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "普通话词库管理...",IDC_MANAGE_DICTS_BTN,16,44,178,16
    PUSHBUTTON      "确定",IDOK,70,80,54,16
    PUSHBUTTON      "取消",IDCANCEL,140,80,54,16
END

IDD_DICT_MGR DIALOGEX 0, 0, 320, 240
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "普通话词库管理"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT           "普通话词库（排在第1位最优先）：",IDC_STATIC,10,8,200,10
    LISTBOX         IDC_DICT_LIST,10,20,220,170,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "上移",IDC_DICT_MOVE_UP,238,20,72,16
    PUSHBUTTON      "下移",IDC_DICT_MOVE_DOWN,238,42,72,16
    PUSHBUTTON      "导入词库...",IDC_DICT_IMPORT,238,70,72,16
    PUSHBUTTON      "删除词库",IDC_DICT_DELETE,238,92,72,16
    PUSHBUTTON      "下载词库",IDC_DICT_DOWNLOAD,238,120,72,16
    PUSHBUTTON      "查看...",IDC_DICT_VIEW,238,144,72,16
    PUSHBUTTON      "关闭",IDCANCEL,238,174,72,16
END

IDD_DICT_VIEW DIALOGEX 0, 0, 420, 300
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "查看词库"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT           "",IDC_DICT_VIEW_INFO,10,8,400,12
    // SysListView32 样式 0x9005 = LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | LVS_OWNERDATA
    CONTROL         "",IDC_DICT_VIEW_LIST,"SysListView32",0x9005 | WS_BORDER | WS_TABSTOP,10,24,400,250
    PUSHBUTTON      "关闭",IDCANCEL,338,274,72,16
END

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x2L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "M2C"
            VALUE "FileDescription", "M2C Pinyin IME (Mandarin/Cantonese)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "M2CIME"
            VALUE "OriginalFilename", "M2CIME.dll"
            VALUE "ProductName", "M2C Pinyin IME"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END